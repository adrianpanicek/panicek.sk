{
  "name": "panicek.sk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/dev.ts",
    "preview": "bun scripts/serve.ts",
    "test": "bun test tests/*.test.ts",
    "test:browser": "bun tests/browser.ts && bun tests/vim-browser.ts && bun tests/download-browser.ts && bun tests/crt-browser.ts && bun tests/visitors-browser.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "bun scripts/package.ts",
    "build:updater": "bun build deploy/pull.ts --compile --target=bun-linux-x64 --outfile .artifacts/panicek-pull",
    "test:browser:ci": "bun scripts/test-browser.ts",
    "build:visitors": "bun build deploy/visitors.ts --compile --minify --target=bun-linux-x64 --outfile .artifacts/panicek-visitors"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@replit/codemirror-vim": "^6.4.0",
    "buffer": "^6.0.3",
    "fflate": "^0.8.3",
    "just-bash": "^3.4.2",
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/html-minifier-terser": "^7.0.2",
    "fake-indexeddb": "^6.2.5",
    "html-minifier-terser": "^7.2.0",
    "image-size": "^2.0.4",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
